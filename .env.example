# No environment variables are required to run this service locally.
# The server listens on port 3000 (host 0.0.0.0) unless PORT is set.

# NODE_ENV: Set to "production" to serve the built dist/ bundle instead of
# running the Vite dev middleware.
NODE_ENV="development"

# PORT: HTTP listen port (default 3000).
# PORT=3000

# TRUST_PROXY: how the caller IP is resolved.
# - unset: legacy multi-header extraction (cf-connecting-ip, x-forwarded-for, …)
# - true:  trust proxy; use X-Forwarded-For only (Docker image default; Caddy)
# - false: ignore forwarded headers; use the socket address
# TRUST_PROXY=true

# DISABLE_HMR: Set to "true" to disable Vite's dev-server HMR/file watching
# (useful in constrained/sandboxed dev environments).
DISABLE_HMR="false"
