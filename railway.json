{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "nixpacksPlan": {
      "variables": {
        "NPM_CONFIG_PRODUCTION": "",
        "NPM_CONFIG_OMIT": "dev"
      },
      "phases": {
        "install": {
          "cmds": ["npm ci --omit=dev"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
